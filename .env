# === Laravel WhatsApp (kstmostofa/laravel-whatsapp) ===
# Web sidecar (personal WhatsApp number via whatsapp-web.js).
# Generate a token with: php -r "echo bin2hex(random_bytes(32));"
WHATSAPP_WEB_ENABLED=true
WHATSAPP_WEB_TOKEN=18b0098c311b6d3d746e77a06c468adcde5b2f26b13f575f8afd010bbb74bd47
WHATSAPP_WEB_HOST=127.0.0.1
WHATSAPP_WEB_PORT=3000
# Path relatif ke sidecar proyek (sudah disalin saat vendor:publish)
WHATSAPP_WEB_SIDECAR_PATH=whatsapp-sidecar
# Headless mode: UI admin dirender di dalam Filament, bukan UI bawaan /whatsapp
WHATSAPP_UI_ENABLED=false
# Nonaktifkan webhook Meta Cloud API (tidak dipakai di mode Web sidecar)
WHATSAPP_WEBHOOK_ENABLED=false
